# Copiá este archivo a `.env` (que está en .gitignore) y cambiá las contraseñas.
# Lo leen: docker compose, la API en Development (solo variables que no estén ya definidas) y Vite.

# ---------- Postgres (docker compose) ----------
POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
APP_DB_NAME=turnero
# Dueño de las tablas; corre las migraciones.
APP_MIGRATOR_PASSWORD=change-me-migrator
# Rol con el que se conecta la API (sin ownership ni BYPASSRLS).
APP_RUNTIME_PASSWORD=change-me-runtime

# ---------- API (ASP.NET Core) ----------
# Conexión de la app: SIEMPRE con app_runtime.
ConnectionStrings__App=Host=localhost;Port=5432;Database=turnero;Username=app_runtime;Password=change-me-runtime
# Conexión de migraciones: app_migrator.
ConnectionStrings__Migrations=Host=localhost;Port=5432;Database=turnero;Username=app_migrator;Password=change-me-migrator
# Clave HMAC para firmar los JWT. Mínimo 32 bytes. Generala con: openssl rand -base64 48
Jwt__SigningKey=change-me-to-a-long-random-secret-of-at-least-32-bytes
Jwt__Issuer=turnero-api
Jwt__Audience=turnero-web
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14
# Aplica las migraciones al arrancar (solo usar en Development).
Database__ApplyMigrationsOnStartup=true

# ---------- Frontend (Vite) ----------
# Hacia dónde proxea Vite las llamadas a /api y /health en desarrollo.
API_PROXY_TARGET=http://localhost:5080

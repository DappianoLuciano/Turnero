# Plantilla: la imagen oficial de Nginx reemplaza ${API_UPSTREAM} al arrancar (solo variables definidas).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    client_max_body_size 2m;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;

    # Misma origin para la API: la cookie de refresh y el cliente (location.origin) funcionan sin CORS.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Agrega la IP que ve Nginx a la lista. Si delante hay otro proxy (Railway, Render, Cloudflare), la API debe
        # confiar en 2 saltos: ForwardedHeaders__ForwardLimit=2 (ver docs/DEPLOY.md).
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        proxy_pass ${API_UPSTREAM};
    }

    # El service worker y el manifest nunca se cachean: si no, una versión nueva tarda en llegar.
    location ~* ^/(sw\.js|registerSW\.js|workbox-.*\.js|manifest\.webmanifest)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # Archivos con hash en el nombre: cache largo.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA: /app/*, /r/:slug/* y el resto las resuelve React Router.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
